<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 无标题栏，适配电视大屏 -->
    <style name="Theme.TvPower" parent="Theme.AppCompat.Light.NoActionBar">

        <!-- 显式指定不透明窗口背景：不写这一项时，部分电视固件会把窗口渲染成透明，直接透出桌面 -->
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>

        <!-- 明确关闭透明/悬浮窗口，避免继承到 Translucent 属性 -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Android 12+ 启动画面背景，避免冷启动瞬间先透出桌面 -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/tv_background</item>
    </style>
</resources>
